; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AMAZING//CLASH"
run/main_scene="res://ui/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
MatchState="*res://core/match_state.gd"
InputManager="*res://input/input_manager.gd"
NetworkManager="*res://net/network_manager.gd"
LobbyState="*res://net/lobby_state.gd"
LanDiscovery="*res://net/lan_discovery.gd"
ReconnectManager="*res://net/reconnect_manager.gd"
GameLog="*res://net/game_log.gd"
ReplayRecorder="*res://net/replay_recorder.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

