excluded_directories:
  - .git
  - addons
max-file-lines: 2000
# Default (20) is tuned for production classes; GUT's one-test-per-
# method convention means a growing test file legitimately exceeds it
# (test_chassis.gd was already at 20 before this bump). 40 gives real
# headroom without going unlimited.
max-public-methods: 40
